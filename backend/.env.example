# Copy this file to .env (same folder) and fill in your values. .env is never committed to git.
# With no AI key, JobPilot uses its built-in basic mode.

# Option 1 (free tier): Google Gemini key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Option 2 (paid): Claude key from https://console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# If both keys are set, Claude is used. Force one with: AI_PROVIDER=gemini  (or claude)

# Optional: send real follow-up reminder emails through Gmail (use a Gmail "App password").
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=

# Optional: show real interview-experience posts from LeetCode, GFG, Glassdoor, AmbitionBox and Reddit.
# Free key from https://tavily.com (Dashboard -> API Keys). It starts with "tvly-".
# TAVILY_API_KEY=
